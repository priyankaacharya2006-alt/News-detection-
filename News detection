        "label": "REAL",
    },
    {
        "id": 3,
        "news": "The government published an official notice announcing examination dates.",
        "label": "REAL",
    },
    {
        "id": 4,
        "news": "A university website published its official admission schedule.",
        "label": "REAL",
    },
    {
        "id": 5,
